# Copy to christmas-duck.env next to deploy.sh and fill it in (first time only):
#   cp christmas-duck.env.example christmas-duck.env && chmod 600 christmas-duck.env
# Quote any value that contains spaces.

# Password for owner.html.
OWNER_PASSWORD=change-me-to-something-long

# Signs owner logins and email review links. Generate once with:
#   openssl rand -hex 32
# Changing it logs you out and breaks review links already sent.
SECRET=

# Listen only on localhost; the web server in front of it handles HTTPS.
# (8081 so it doesn't collide with puzzle-table on 8080.)
LISTEN_HOST=127.0.0.1
PORT=8081
TRUST_PROXY=true

# The public HTTPS address of this server (used in photo URLs and review links).
PUBLIC_URL=https://duck.example.com

# Where the website lives. Leave as PUBLIC_URL if this server serves the site;
# for GitHub Pages use https://smartybryan.github.io/steal-some-christmas-cheer
SITE_URL=https://duck.example.com

# Only needed when the site is on GitHub Pages.
ALLOWED_ORIGINS=

# Registrations, photos and settings live here (relative to this folder). Back it up.
DATA_DIR=data

# Email alerts. The recipient is set on the owner Settings page;
# NOTIFY_EMAIL is only a fallback. For Gmail use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# Optional text alerts through Twilio.
NOTIFY_SMS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
